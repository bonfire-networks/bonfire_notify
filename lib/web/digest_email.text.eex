<%= @title %>
<%= @intro %>
<%= for section <- @sections do %>
<%= section.name %> @<%= section.username %><%= if section.count > 0 do %>: <%= lp("%{count} notification", "%{count} notifications", section.count, count: section.count) %><% end %>
<%= if section.messages > 0 do %><%= lp("%{count} new message", "%{count} new messages", section.messages, count: section.messages) %>: <%= @messages_url %>
<% end %><%= for row <- section.rows do %>
<%= row.text %>
<% end %><% end %>
<%= l("Open notifications") %>: <%= @notifications_url %>
<%= l("Change which notifications are emailed, and how often") %>: <%= @settings_url %>
