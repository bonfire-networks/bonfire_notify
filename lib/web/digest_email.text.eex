<%= @title %>
<%= @intro %>
<%= for section <- @sections do %>
<%= section.name %> @<%= section.username %>: <%= lp("%{count} notification", "%{count} notifications", section.count, count: section.count) %>
<%= for row <- section.rows do %>
<%= row.text %>
<% end %><% end %>
<%= l("Open notifications") %>: <%= @notifications_url %>
<%= l("Change which notifications are emailed, and how often") %>: <%= @settings_url %>
